{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --prefix stcine-web-app",
  "buildCommand": "npm run build --prefix stcine-web-app",
  "outputDirectory": "stcine-web-app/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/vod/[id].js": {
      "maxDuration": 60
    },
    "api/vod/[id]/similar.js": {
      "maxDuration": 60
    },
    "api/vod/[id]/stream.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}